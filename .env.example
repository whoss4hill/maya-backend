# Copy to .env for local use. NEVER commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
# Immutable Supabase auth user id (uuid) of the single permitted user. Unset = deny all.
MAYA_OWNER_USER_ID=
# PUBLIC anon key, used only by the /auth/reset page. Never the service-role key.
SUPABASE_ANON_KEY=
